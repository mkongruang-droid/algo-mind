// ALGO MIND — XAUUSD Day Trade v1 (Rule A)
// Spec: docs/STRATEGY_SPEC.md
// Chart: EIGHTCAP:XAUUSD, 30m. Bias = H4 structure, Setup = H1, Entry = chart TF.
// Required: ① structure + ③ volume-profile zone + ⑤ price-action trigger + ④ risk gate.
// Optional: ② MACD confirmation → grade A (else B). ⑥ Fib extension is used for targets only.
// Not handled here (do it in the bridge / backend): news blackout, live spread filter,
// cross-symbol exposure.

//@version=6
strategy("ALGO MIND — XAUUSD Day v1", shorttitle = "ALGO MIND v1", overlay = true,
     initial_capital = 10000, currency = currency.USD, default_qty_type = strategy.fixed,
     pyramiding = 0, slippage = 15, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.0, max_bars_back = 500, max_lines_count = 50)

// ─────────────────────────────── Inputs ───────────────────────────────
grpS = "① Market Structure"
biasTF      = input.timeframe("240", "Bias TF", group = grpS)
setupTF     = input.timeframe("60", "Setup TF (Fib / ATR)", group = grpS)
swingLen    = input.int(3, "SwingLen", minval = 1, group = grpS)
minSwingAtr = input.float(0.5, "MinSwingATR", step = 0.1, group = grpS)

grpV = "③ Volume Profile (prior day)"
vpLTF     = input.timeframe("5", "Intrabar TF for profile", group = grpV)
vpBins    = input.int(100, "VP_Bins", minval = 20, maxval = 400, group = grpV)
vaPct     = input.float(70, "VA_Percent", minval = 50, maxval = 95, group = grpV)
hvnMult   = input.float(1.5, "HVN_Mult", step = 0.1, group = grpV)
zoneWAtr  = input.float(0.25, "ZoneWidthATR (Setup TF)", step = 0.05, group = grpV)
touchBars = input.int(6, "ZoneTouchBars", minval = 1, group = grpV)

grpP = "⑤ Price Action"
ltfLen        = input.int(2, "LTF_SwingLen", minval = 1, group = grpP)
engulfMinBody = input.float(0.5, "EngulfMinBodyATR", step = 0.1, group = grpP)
useChoch      = input.bool(true, "Enable CHoCH", group = grpP)
useEngulf     = input.bool(true, "Enable Engulfing", group = grpP)

grpM = "② MACD (grade)"
useMacdGrade = input.bool(true, "UseMACDGrade (off = every trade grade B)", group = grpM)
mFast        = input.int(12, "Fast", group = grpM)
mSlow        = input.int(26, "Slow", group = grpM)
mSig         = input.int(9, "Signal", group = grpM)
divLookback  = input.int(20, "DivLookback", group = grpM)

grpX = "⑥ Exits"
slBufAtr   = input.float(0.4, "SLBufferATR (Entry TF)", step = 0.05, group = grpX)
maxSlAtr   = input.float(2.0, "MaxSL_ATR (Setup TF)", step = 0.1, group = grpX)
confAtr    = input.float(0.3, "ConfluenceATR (Setup TF)", step = 0.05, group = grpX)
split1     = input.int(50, "TP1 %", minval = 0, maxval = 100, group = grpX)
split2     = input.int(30, "TP2 %", minval = 0, maxval = 100, group = grpX)
dayCloseHr = input.int(20, "Time stop hour (UTC)", minval = 0, maxval = 23, group = grpX)

grpR = "④ Risk Gate"
riskA     = input.float(1.0, "Risk % grade A", step = 0.05, group = grpR)
riskB     = input.float(0.5, "Risk % grade B", step = 0.05, group = grpR)
minRR     = input.float(2.0, "MinRR (to TP2)", step = 0.1, group = grpR)
minRRFib  = input.float(1.5, "MinRR_Fib100", step = 0.1, group = grpR)
dailyLim  = input.float(3.0, "DailyLossLimit %", step = 0.5, group = grpR)
weeklyLim = input.float(6.0, "WeeklyLossLimit %", step = 0.5, group = grpR)
maxConsec = input.int(4, "MaxConsecLosses (per day)", minval = 1, group = grpR)
sess      = input.session("0700-2000", "Entry session (UTC)", group = grpR)
friCutHr  = input.int(18, "Friday cutoff hour (UTC)", minval = 0, maxval = 23, group = grpR)
qtyStep   = input.float(1.0, "Qty step (units)", minval = 0.001, group = grpR)

grpA = "Webhook"
whSecret = input.string("CHANGE_ME", "Webhook secret", group = grpA)
whSymbol = input.string("XAUUSD", "Broker symbol (MT5)", group = grpA)

strategy.risk.max_intraday_loss(dailyLim, strategy.percent_of_equity)

// ─────────────────────────────── Helpers ───────────────────────────────
// Swing structure on a higher TF. Returns values of the last closed HTF bar (no repaint).
f_structure(int len, float minAtr) =>
    float a  = ta.atr(14)
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float sh    = na
    var float sl    = na
    var int   bias  = 0
    var float bullA = na
    var float bullB = na
    var float bearA = na
    var float bearB = na
    if not na(ph) and (na(sl) or ph - sl >= minAtr * a)
        bullA := sl
        bullB := ph
        sh    := ph
    if not na(pl) and (na(sh) or sh - pl >= minAtr * a)
        bearA := sh
        bearB := pl
        sl    := pl
    if not na(sh) and close > sh
        bias := 1
    else if not na(sl) and close < sl
        bias := -1
    [bias[1], bullA[1], bullB[1], bearA[1], bearB[1], a[1]]

f_get(array<float> arr, int i) =>
    float r = na
    if array.size(arr) > i
        r := array.get(arr, i)
    r

f_num(float x) =>
    na(x) ? "null" : str.tostring(x, format.mintick)

// Builds a volume profile from bars (h/l/v), fills hvnOut, returns [POC, VAH, VAL].
f_buildProfile(array<float> hs, array<float> ls, array<float> vs, int bins, float vaP, float hvnM, array<float> hvnOut) =>
    array.clear(hvnOut)
    float lo   = array.min(ls)
    float hi   = array.max(hs)
    float step = (hi - lo) / bins
    float poc  = na
    float vah  = na
    float val  = na
    if step > 0
        array<float> prof = array.new<float>(bins, 0.0)
        for j = 0 to array.size(hs) - 1
            float bh = array.get(hs, j)
            float bl = array.get(ls, j)
            float bv = nz(array.get(vs, j))
            int b0 = math.max(0, math.min(bins - 1, math.floor((bl - lo) / step)))
            int b1 = math.max(0, math.min(bins - 1, math.floor((bh - lo) / step)))
            float share = bv / (b1 - b0 + 1)
            for bi = b0 to b1
                array.set(prof, bi, array.get(prof, bi) + share)
        float total = array.sum(prof)
        if total > 0
            int pocIdx = array.indexof(prof, array.max(prof))
            int up = pocIdx
            int dn = pocIdx
            float acc = array.get(prof, pocIdx)
            while acc < total * vaP / 100 and (up < bins - 1 or dn > 0)
                float vUp = up < bins - 1 ? array.get(prof, up + 1) : -1.0
                float vDn = dn > 0 ? array.get(prof, dn - 1) : -1.0
                if vUp >= vDn
                    up += 1
                    acc += vUp
                else
                    dn -= 1
                    acc += vDn
            poc := lo + (pocIdx + 0.5) * step
            vah := lo + (up + 1) * step
            val := lo + dn * step
            // HVN: local volume peaks above hvnM × mean, away from POC, top 3
            float mean = total / bins
            array<int> cand = array.new<int>()
            for ci = 1 to bins - 2
                float cv = array.get(prof, ci)
                if cv > hvnM * mean and cv > array.get(prof, ci - 1) and cv >= array.get(prof, ci + 1) and math.abs(ci - pocIdx) > 2
                    array.push(cand, ci)
            array<int> chosen = array.new<int>()
            for n = 1 to 3
                int best = -1
                float bestV = -1.0
                if array.size(cand) > 0
                    for m = 0 to array.size(cand) - 1
                        int cb = array.get(cand, m)
                        float cbv = array.get(prof, cb)
                        bool far = true
                        if array.size(chosen) > 0
                            for q = 0 to array.size(chosen) - 1
                                if math.abs(array.get(chosen, q) - cb) <= 2
                                    far := false
                        if far and cbv > bestV
                            best := cb
                            bestV := cbv
                if best >= 0
                    array.push(chosen, best)
                    array.push(hvnOut, lo + (best + 0.5) * step)
    [poc, vah, val]

// Trade plan for direction d (1 = buy, -1 = sell).
// c = extreme of the zone touch (Fib point C), A/B = impulse leg on the setup TF.
f_plan(int d, float entry, float zoneLvl, float zw, float c, float A, float B, array<float> levels, float aE, float aS) =>
    float edge = zoneLvl - d * zw
    float buf  = slBufAtr * aE
    float sl   = d == 1 ? math.min(edge, c) - buf : math.max(edge, c) + buf
    float risk = (entry - sl) * d
    // VP targets in front of price, nearest first
    array<float> dists = array.new<float>()
    if array.size(levels) > 0
        for k = 0 to array.size(levels) - 1
            float lv = array.get(levels, k)
            if not na(lv) and (lv - entry) * d > 0
                array.push(dists, (lv - entry) * d)
    array.sort(dists, order.ascending)
    float tp1 = na
    float tp2 = na
    bool tp2IsVP = false
    int i1 = -1
    if risk > 0 and array.size(dists) > 0
        for k = 0 to array.size(dists) - 1
            if array.get(dists, k) >= risk
                i1 := k
                break
    if i1 >= 0
        tp1 := entry + d * array.get(dists, i1)
        if i1 + 1 < array.size(dists)
            tp2 := entry + d * array.get(dists, i1 + 1)
            tp2IsVP := true
    // Fibonacci extension (targets only)
    bool legOk = not na(A) and not na(B) and not na(c) and (B - A) * d > 0
    float e100 = legOk ? c + (B - A) * 1.0 : na
    float e127 = legOk ? c + (B - A) * 1.272 : na
    float e162 = legOk ? c + (B - A) * 1.618 : na
    if na(tp1) and legOk and (e100 - entry) * d >= risk
        tp1 := e100
    if na(tp2) and legOk
        float ref = na(tp1) ? entry : tp1
        if (e127 - ref) * d > 0
            tp2 := e127
        else if (e162 - ref) * d > 0
            tp2 := e162
    float confW = confAtr * aS
    bool strong = tp2IsVP and legOk and (math.abs(tp2 - e127) <= confW or math.abs(tp2 - e162) <= confW)
    float tp3 = legOk and not na(tp2) and not strong and (e162 - tp2) * d > 0 ? e162 : na
    bool merged = not na(tp1) and not na(tp2) and (tp2 - tp1) * d < 0.5 * risk
    float rr2 = risk > 0 and not na(tp2) ? (tp2 - entry) * d / risk : na
    float rrF = risk > 0 and legOk ? (e100 - entry) * d / risk : na
    string reason = ""
    if risk <= 0
        reason := "invalid SL"
    else if risk > maxSlAtr * aS
        reason := "SL too wide"
    else if na(rr2) or rr2 < minRR
        reason := "RR to TP2 < " + str.tostring(minRR)
    else if na(rrF) or rrF < minRRFib
        reason := "Fib 1.0 RR < " + str.tostring(minRRFib)
    [reason, sl, risk, tp1, tp2, tp3, strong, merged, rr2]

// ─────────────────────── ① Market structure (H4) ───────────────────────
[biasH4, hA1, hB1, hA2, hB2, atrH4] = request.security(syminfo.tickerid, biasTF, f_structure(swingLen, minSwingAtr), lookahead = barmerge.lookahead_on)
[biasH1, bullA, bullB, bearA, bearB, atrSetup] = request.security(syminfo.tickerid, setupTF, f_structure(swingLen, minSwingAtr), lookahead = barmerge.lookahead_on)

float atrE = ta.atr(14)

// ─────────────────────── ③ Volume profile (prior day) ───────────────────────
var array<float> dH = array.new<float>()
var array<float> dL = array.new<float>()
var array<float> dV = array.new<float>()
var array<float> pdHVN = array.new<float>()
var float pdPOC = na
var float pdVAH = na
var float pdVAL = na

[ltfH, ltfL, ltfV] = request.security_lower_tf(syminfo.tickerid, vpLTF, [high, low, volume])
bool newDay = timeframe.change("D")

if newDay and array.size(dH) > 0
    [poc, vah, val] = f_buildProfile(dH, dL, dV, vpBins, vaPct, hvnMult, pdHVN)
    pdPOC := poc
    pdVAH := vah
    pdVAL := val
    array.clear(dH)
    array.clear(dL)
    array.clear(dV)

if array.size(ltfH) > 0
    for i = 0 to array.size(ltfH) - 1
        array.push(dH, array.get(ltfH, i))
        array.push(dL, array.get(ltfL, i))
        array.push(dV, nz(array.get(ltfV, i)))
else
    array.push(dH, high)
    array.push(dL, low)
    array.push(dV, nz(volume))

float zoneW     = zoneWAtr * nz(atrSetup)
float lowLow    = ta.lowest(low, touchBars)
float lowClose  = ta.lowest(close, touchBars)
float highHigh  = ta.highest(high, touchBars)
float highClose = ta.highest(close, touchBars)

// Buy zones: VAL / POC / HVN under price.  Sell zones: VAH / POC / HVN above price.
float  buyLvl  = na
string buyNm   = ""
float  sellLvl = na
string sellNm  = ""
if not na(pdPOC) and not na(atrSetup)
    array<float>  bPx = array.from(pdVAL, pdPOC)
    array<string> bNm = array.from("VAL", "POC")
    array<float>  sPx = array.from(pdVAH, pdPOC)
    array<string> sNm = array.from("VAH", "POC")
    if array.size(pdHVN) > 0
        for k = 0 to array.size(pdHVN) - 1
            array.push(bPx, array.get(pdHVN, k))
            array.push(bNm, "HVN")
            array.push(sPx, array.get(pdHVN, k))
            array.push(sNm, "HVN")
    for k = 0 to array.size(bPx) - 1
        float lv = array.get(bPx, k)
        bool touched = lowLow <= lv + zoneW and lowClose >= lv - zoneW - atrSetup and close > lv - zoneW
        if touched and (na(buyLvl) or lv > buyLvl)
            buyLvl := lv
            buyNm  := array.get(bNm, k)
    for k = 0 to array.size(sPx) - 1
        float lv = array.get(sPx, k)
        bool touched = highHigh >= lv - zoneW and highClose <= lv + zoneW + atrSetup and close < lv + zoneW
        if touched and (na(sellLvl) or lv < sellLvl)
            sellLvl := lv
            sellNm  := array.get(sNm, k)

// ─────────────────────── ⑤ Price action trigger ───────────────────────
float lph = ta.pivothigh(high, ltfLen, ltfLen)
float lpl = ta.pivotlow(low, ltfLen, ltfLen)
var float lastLH = na
var float lastLL = na
if not na(lph)
    lastLH := lph
if not na(lpl)
    lastLL := lpl

bool xUpLH = ta.crossover(close, lastLH)
bool xDnLL = ta.crossunder(close, lastLL)
float body = math.abs(close - open)
bool bullEngulf = useEngulf and close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body >= engulfMinBody * atrE
bool bearEngulf = useEngulf and close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body >= engulfMinBody * atrE
bool bullChoch  = useChoch and xUpLH
bool bearChoch  = useChoch and xDnLL

// ─────────────────────── ② MACD ───────────────────────
[macdLine, sigLine, hist] = ta.macd(close, mFast, mSlow, mSig)
bool hxUp = ta.crossover(hist, 0)
bool hxDn = ta.crossunder(hist, 0)
bool bullHist = hxUp or hxUp[1] or hxUp[2] or (hist < 0 and hist > hist[1] and hist[1] > hist[2])
bool bearHist = hxDn or hxDn[1] or hxDn[2] or (hist > 0 and hist < hist[1] and hist[1] < hist[2])

var float pl1 = na
var float pl1m = na
var int   pl1b = na
var float pl2 = na
var float pl2m = na
var int   pl2b = na
var float ph1 = na
var float ph1m = na
var int   ph1b = na
var float ph2 = na
var float ph2m = na
var int   ph2b = na
if not na(lpl)
    pl2  := pl1
    pl2m := pl1m
    pl2b := pl1b
    pl1  := lpl
    pl1m := macdLine[ltfLen]
    pl1b := bar_index - ltfLen
if not na(lph)
    ph2  := ph1
    ph2m := ph1m
    ph2b := ph1b
    ph1  := lph
    ph1m := macdLine[ltfLen]
    ph1b := bar_index - ltfLen
bool bullDiv = not na(pl2) and pl1 < pl2 and pl1m > pl2m and bar_index - pl1b <= divLookback and pl1b - pl2b <= divLookback and not na(buyLvl) and pl1 <= buyLvl + zoneW
bool bearDiv = not na(ph2) and ph1 > ph2 and ph1m < ph2m and bar_index - ph1b <= divLookback and ph1b - ph2b <= divLookback and not na(sellLvl) and ph1 >= sellLvl - zoneW

// ─────────────────────── ④ Risk state ───────────────────────
var int    tDir      = 0
var bool   tFilled   = false
var float  tSL       = na
var float  tTP1      = na
var float  tTP2      = na
var float  tTP3      = na
var float  tQty      = 0.0
var float  tQ1       = 0.0
var float  tQ2       = 0.0
var float  tQ3       = 0.0
var bool   tBE       = false
var bool   tTrail    = false
var bool   tTP1Done  = false
var bool   tTP2Done  = false
var float  npAtEntry = 0.0
var int    consec    = 0
var bool   dayHalt   = false
var bool   weekHalt  = false
var float  weekEq    = strategy.initial_capital
var string lastReason = "—"
var string lastGrade  = "—"

if newDay
    dayHalt := false
    consec  := 0
if timeframe.change("W")
    weekEq   := strategy.equity
    weekHalt := false
if strategy.equity <= weekEq * (1 - weeklyLim / 100)
    weekHalt := true

float absPos = math.abs(strategy.position_size)
float eps    = qtyStep * 0.5
if absPos > 0
    tFilled := true

// Position closed → book result and reset
if tDir != 0 and tFilled and absPos == 0
    float pnl = strategy.netprofit - npAtEntry
    consec := pnl < 0 ? consec + 1 : 0
    if consec >= maxConsec
        dayHalt := true
    tDir     := 0
    tFilled  := false
    tBE      := false
    tTrail   := false
    tTP1Done := false
    tTP2Done := false

int    utcHour = hour(time, "UTC")
bool   inSess  = not na(time(timeframe.period, sess, "UTC"))
bool   friCut  = dayofweek(time, "UTC") == dayofweek.friday and utcHour >= friCutHr
bool   canOpen = inSess and not friCut and not dayHalt and not weekHalt and utcHour < dayCloseHr

// ─────────────────────── Signal → plan → entry ───────────────────────
int    dir     = biasH4
bool   zoneOk  = dir == 1 ? not na(buyLvl) : dir == -1 ? not na(sellLvl) : false
bool   trigOk  = dir == 1 ? (bullEngulf or bullChoch) : dir == -1 ? (bearEngulf or bearChoch) : false
string trigNm  = dir == 1 ? (bullChoch ? "CHoCH" : bullEngulf ? "Engulfing" : "—") : dir == -1 ? (bearChoch ? "CHoCH" : bearEngulf ? "Engulfing" : "—") : "—"
bool   macdOk  = dir == 1 ? (bullHist or bullDiv) : dir == -1 ? (bearHist or bearDiv) : false
float  zoneLvl = dir == 1 ? buyLvl : sellLvl
string zoneNm  = dir == 1 ? buyNm : dir == -1 ? sellNm : ""
bool   entered = false

if absPos == 0 and tDir == 0
    if dir == 0
        lastReason := "No H4 bias"
    else if not zoneOk
        lastReason := "Waiting for VP zone"
    else if not trigOk
        lastReason := "In zone, waiting for trigger"
    else if not canOpen
        lastReason := dayHalt ? "Halted: consecutive losses" : weekHalt ? "Halted: weekly loss" : "Outside session"
    else
        array<float> allLv = array.from(pdVAL, pdPOC, pdVAH)
        if array.size(pdHVN) > 0
            for k = 0 to array.size(pdHVN) - 1
                array.push(allLv, array.get(pdHVN, k))
        float c = dir == 1 ? lowLow : highHigh
        float A = dir == 1 ? bullA : bearA
        float B = dir == 1 ? bullB : bearB
        [reason, sl, risk, tp1, tp2, tp3, strong, merged, rr2] = f_plan(dir, close, zoneLvl, zoneW, c, A, B, allLv, atrE, atrSetup)
        if reason != ""
            lastReason := reason
        else
            string grade = useMacdGrade and macdOk ? "A" : "B"
            float  rp    = grade == "A" ? riskA : riskB
            float  qty   = math.floor(strategy.equity * rp / 100 / (risk * syminfo.pointvalue) / qtyStep) * qtyStep
            if qty < qtyStep
                lastReason := "Size below minimum"
            else
                float q1 = na(tp1) or merged ? 0.0 : math.floor(qty * split1 / 100 / qtyStep) * qtyStep
                float q2 = 0.0
                if strong
                    q2 := qty - q1
                else if merged
                    q2 := math.floor(qty * (split1 + split2) / 100 / qtyStep) * qtyStep
                else
                    q2 := math.floor(qty * split2 / 100 / qtyStep) * qtyStep
                float q3 = qty - q1 - q2
                tDir      := dir
                tSL       := sl
                tTP1      := q1 > 0 ? tp1 : na
                tTP2      := tp2
                tTP3      := tp3
                tQty      := qty
                tQ1       := q1
                tQ2       := q2
                tQ3       := q3
                npAtEntry := strategy.netprofit
                lastGrade := grade
                lastReason := "ENTERED " + (dir == 1 ? "BUY" : "SELL") + " grade " + grade + " RR " + str.tostring(rr2, "#.##")
                entered := true
                if dir == 1
                    strategy.entry("L", strategy.long, qty = qty, comment = "BUY " + grade)
                else
                    strategy.entry("S", strategy.short, qty = qty, comment = "SELL " + grade)
                string msg = '{"secret":"' + whSecret + '","symbol":"' + whSymbol + '","action":"' + (dir == 1 ? "BUY" : "SELL") +
                     '","grade":"' + grade + '","risk_pct":' + str.tostring(rp) + ',"entry":' + f_num(close) + ',"sl":' + f_num(sl) +
                     ',"tp1":' + f_num(tTP1) + ',"tp2":' + f_num(tp2) + ',"tp3":' + f_num(tp3) +
                     ',"split":[' + str.tostring(math.round(q1 / qty * 100)) + ',' + str.tostring(math.round(q2 / qty * 100)) + ',' + str.tostring(math.round(q3 / qty * 100)) +
                     '],"be_after_tp1":true,"trail_after_tp2":' + (q3 > 0 ? "true" : "false") + ',"zone":"' + zoneNm + '","trigger":"' + trigNm + '"}'
                alert(msg, alert.freq_once_per_bar_close)

// ─────────────────────── Trade management ───────────────────────
if absPos > 0 and tDir != 0
    if tQ1 > 0 and not tTP1Done and absPos <= tQty - tQ1 + eps
        tTP1Done := true
    if tQ2 > 0 and not tTP2Done and absPos <= tQ3 + eps
        tTP2Done := true
    // Breakeven after the first partial close
    if not tBE and absPos < tQty - eps
        tBE := true
        tSL := strategy.position_avg_price
        alert('{"secret":"' + whSecret + '","symbol":"' + whSymbol + '","action":"MODIFY_SL","sl":' + f_num(tSL) + '}', alert.freq_once_per_bar_close)
    // Trail the runner behind entry-TF swings after TP2
    if tBE and not tTrail and tQ3 > 0 and absPos <= tQ3 + eps
        tTrail := true
    if tTrail
        float cand = tDir == 1 ? lastLL - slBufAtr * atrE : lastLH + slBufAtr * atrE
        if not na(cand) and (cand - tSL) * tDir > 0 and (close - cand) * tDir > 0
            tSL := cand
            alert('{"secret":"' + whSecret + '","symbol":"' + whSymbol + '","action":"MODIFY_SL","sl":' + f_num(tSL) + '}', alert.freq_once_per_bar_close)
    // Day-trade time stop
    if utcHour >= dayCloseHr
        strategy.close_all(comment = "Time stop")
        alert('{"secret":"' + whSecret + '","symbol":"' + whSymbol + '","action":"CLOSE"}', alert.freq_once_per_bar_close)

if tDir != 0
    string eid = tDir == 1 ? "L" : "S"
    if tQ1 > 0 and not tTP1Done
        strategy.exit(eid + "-TP1", eid, qty = tQ1, limit = tTP1, stop = tSL)
    if tQ2 > 0 and not tTP2Done
        strategy.exit(eid + "-TP2", eid, qty = tQ2, limit = tTP2, stop = tSL)
    if tQ3 > 0
        strategy.exit(eid + "-TP3", eid, qty = tQ3, limit = tTP3, stop = tSL)

// ─────────────────────── Visuals ───────────────────────
plot(pdPOC, "Prior-day POC", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(pdVAH, "Prior-day VAH", color = color.new(color.teal, 20), style = plot.style_linebr)
plot(pdVAL, "Prior-day VAL", color = color.new(color.teal, 20), style = plot.style_linebr)
plot(f_get(pdHVN, 0), "HVN 1", color = color.new(color.purple, 40), style = plot.style_linebr)
plot(f_get(pdHVN, 1), "HVN 2", color = color.new(color.purple, 40), style = plot.style_linebr)
plot(f_get(pdHVN, 2), "HVN 3", color = color.new(color.purple, 40), style = plot.style_linebr)
plot(tDir != 0 ? tSL : na, "SL", color = color.red, style = plot.style_linebr)
plot(tDir != 0 ? tTP1 : na, "TP1", color = color.lime, style = plot.style_linebr)
plot(tDir != 0 ? tTP2 : na, "TP2", color = color.green, style = plot.style_linebr)
plot(tDir != 0 ? tTP3 : na, "TP3", color = color.new(color.green, 50), style = plot.style_linebr)
plotshape(entered and tDir == 1, "Buy", shape.triangleup, location.belowbar, color.lime, size = size.small)
plotshape(entered and tDir == -1, "Sell", shape.triangledown, location.abovebar, color.red, size = size.small)
bgcolor(biasH4 == 1 ? color.new(color.green, 94) : biasH4 == -1 ? color.new(color.red, 94) : na, title = "H4 bias")

// Checklist dashboard
var table dash = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    color ok = color.lime
    color no = color.gray
    table.cell(dash, 0, 0, "ALGO MIND v1", text_color = color.yellow)
    table.cell(dash, 1, 0, "XAUUSD · Day", text_color = color.yellow)
    table.cell(dash, 0, 1, "① Structure H4", text_color = color.white)
    table.cell(dash, 1, 1, dir == 1 ? "BULL" : dir == -1 ? "BEAR" : "NEUTRAL", text_color = dir != 0 ? ok : no)
    table.cell(dash, 0, 2, "③ VP zone", text_color = color.white)
    table.cell(dash, 1, 2, zoneOk ? zoneNm + " " + str.tostring(zoneLvl, format.mintick) : "—", text_color = zoneOk ? ok : no)
    table.cell(dash, 0, 3, "⑤ Trigger", text_color = color.white)
    table.cell(dash, 1, 3, trigOk ? trigNm : "—", text_color = trigOk ? ok : no)
    table.cell(dash, 0, 4, "② MACD", text_color = color.white)
    table.cell(dash, 1, 4, macdOk ? "confirmed" : "—", text_color = macdOk ? ok : no)
    table.cell(dash, 0, 5, "Grade (last)", text_color = color.white)
    table.cell(dash, 1, 5, lastGrade, text_color = color.white)
    table.cell(dash, 0, 6, "④ Status", text_color = color.white)
    table.cell(dash, 1, 6, lastReason, text_color = color.white)
    table.cell(dash, 0, 7, "POC / VAH / VAL", text_color = color.white)
    table.cell(dash, 1, 7, f_num(pdPOC) + " / " + f_num(pdVAH) + " / " + f_num(pdVAL), text_color = color.white)
    table.cell(dash, 0, 8, "Chart TF", text_color = color.white)
    table.cell(dash, 1, 8, timeframe.period == "30" ? "30m ✓" : timeframe.period + " (use 30m)", text_color = timeframe.period == "30" ? ok : color.orange)
